# ==============================================================================
# INARO — Master Environment Variable Template (.env.example)
# Copy this file to .env and adjust variables for your local setup.
# NEVER commit your actual .env file or private credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE BACKEND CONFIGURATION (server/)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection String (Primary Application Database - Mongoose)
# Local: mongodb://localhost:27017/inaro_db | Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/inaro_db
MONGODB_URI=mongodb://localhost:27017/inaro_db

# SQLite / Prisma Database (Dump Mode & Safety Audit Logs)
DATABASE_URL=file:./dev.db

# JWT & Authentication Secrets (Member 4 Scope)
# Generate secure random strings: openssl rand -base64 32
JWT_SECRET=inaro_dev_jwt_secret_change_in_production_min_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=inaro_dev_cookie_secret_change_in_production

# Dump Mode Encryption at Rest (Member 4 Scope)
# 256-bit AES-GCM Key (32-byte string or 64-hex string)
DUMP_ENCRYPTION_KEY=inaro_secure_aes256_gcm_encryption_key_change_in_production_min_32_chars

# OTP Service Configuration (Member 1 & Member 4 Scope)
# Provider options: "console" (prints to terminal for free local dev) | "twilio" (production SMS)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Twilio SMS Credentials (Member 4 Scope - required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 2. AI CONVERSATION & GEMINI API (Member 2 Scope)
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. VOCAL TONE EMOTION MICROSERVICE & AUDIO PIPELINE (Member 3 Scope)
# ------------------------------------------------------------------------------
# Internal vocal tone emotion analysis microservice URL
AI_EMOTION_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
CONFIDENCE_THRESHOLD=0.60
AUDIO_SAMPLE_RATE=16000
EDGE_TTS_VOICE=en-US-JennyNeural

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT CONFIGURATION (client/) - Member 1 Scope
# ------------------------------------------------------------------------------
# Note: In Vite, variables exposed to browser must start with VITE_
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AI_EMOTION_URL=http://localhost:8000/api/v1
VITE_APP_NAME="INARO Well-Being"
