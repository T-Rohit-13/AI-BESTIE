# ==============================================================================
# INARO — Master Environment Variable Template (.env.example)
# Copy this file to .env and adjust variables for your local setup.
# NEVER commit your actual .env file or private credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE BACKEND CONFIGURATION (server/)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL — primary app DB)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inaro_db?schema=public

# Auth Microservice — MongoDB (Member 1 Scope: server/src/modules/auth/)
# Local: mongodb://localhost:27017/inaro_auth  | Atlas: mongodb+srv://...
MONGO_URI=mongodb://localhost:27017/inaro_auth
AUTH_PORT=5001

# JWT & Authentication Secrets (Member 1)
# Generate secure random strings: openssl rand -base64 32
JWT_SECRET=inaro_dev_jwt_secret_change_in_production_min_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=inaro_dev_cookie_secret_change_in_production

# OTP Service Configuration (Member 1)
# Provider options: "console" (prints to terminal for free local dev) | "twilio" (production SMS)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Twilio Credentials (Optional for local dev, required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gemini API Integration (Members 2 & 3 - Joint Scope)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Note: GEMINI_MODEL requires confirmation against currently active Google AI Studio model availability
# at deployment time (e.g., gemini-1.5-flash or current stable equivalent). Model identifier is decoupled
# and can be updated here without rewriting application code.
GEMINI_MODEL=gemini-1.5-flash

# Internal ML Service Communication (Members 2 & 3 - Joint Scope)
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. ML & AUDIO SERVICE CONFIGURATION (ml-service/) - Members 2 & 3 Joint Scope
# ------------------------------------------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0
MODEL_CHECKPOINT_PATH=models/checkpoints/vocal_aer_v1.onnx
AUDIO_SAMPLE_RATE=16000
CONFIDENCE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (client/)
# ------------------------------------------------------------------------------
# Note: In Vite, variables exposed to the browser MUST start with VITE_
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_ML_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="INARO Well-Being"
