# ==============================================================================
# INARO Auth Microservice — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to Git.
# ==============================================================================

NODE_ENV=development
AUTH_PORT=5001

# MongoDB connection string
# Local:      mongodb://localhost:27017/inaro_auth
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/inaro_auth
MONGO_URI=mongodb://localhost:27017/inaro_auth

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT — generate secure random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=inaro_dev_jwt_secret_CHANGE_IN_PRODUCTION_min32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt salt rounds (10 = fast dev, 12 = production recommended)
BCRYPT_ROUNDS=12

# OTP Provider: "console" (logs to terminal, free) | "twilio" (real SMS)
OTP_PROVIDER=console

# Twilio credentials (only required when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
